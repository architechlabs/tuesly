{
  "domain": "tuesly",
  "name": "Tuesly",
  "version": "0.1.1",
  "integration_type": "device",
  "codeowners": [],
  "config_flow": true,
  "iot_class": "local_push",
  "loggers": [
    "tuesly_mesh"
  ],
  "bluetooth": [
    {
      "local_name": "out_of_mesh*"
    },
    {
      "local_name": "S17*"
    }
  ],
  "dependencies": [
    "bluetooth"
  ],
  "bluetooth_adapters": [
    "esphome"
  ],
  "requirements": [
    "bleak>=0.21",
    "bleak-retry-connector>=3.0",
    "cryptography>=42.0"
  ]
}
